{
   "action": {
      "default_icon": "icons/carometro-icon-192.png",
      "default_popup": "popup/popup.html",
      "default_title": "Assistente SIAP do Professor"
   },
   "background": {
      "service_worker": "src/service-worker.js"
   },
   "content_scripts": [ {
      "js": [ "src/carometro-bridge.js" ],
      "matches": [ "https://sistemacarometro.com.br/*" ],
      "run_at": "document_start",
      "world": "ISOLATED"
   }, {
      "js": [ "src/page-bridge.js" ],
      "matches": [ "https://siap.educacao.go.gov.br/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "css": [ "src/content.css", "src/exam.css" ],
      "js": [ "src/core.js", "src/exam-config.js", "src/vendor/qrcode.js", "src/exam-core.js", "src/exam-dom.js", "src/exam-panel.js", "src/cepi-siap-dom.js", "src/cepi-siap-panel.js", "src/revisa-goias-2026-b4.js", "src/revisa-goias-2026-extra.js", "src/content.js" ],
      "matches": [ "https://siap.educacao.go.gov.br/*" ],
      "run_at": "document_idle"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "Organiza pendências do SIAP e auxilia o professor com planejamento, conteúdo, frequência e PEI.",
   "externally_connectable": {
      "matches": [ "https://sistemacarometro.com.br/*" ]
   },
   "host_permissions": [ "https://siap.educacao.go.gov.br/*", "https://ppkndfwmqdmomkjoemre.supabase.co/functions/v1/generate-siap-ai-draft", "https://ppkndfwmqdmomkjoemre.supabase.co/rest/v1/siap_assistant_announcement", "https://correcao.sistemacarometro.com.br/*" ],
   "icons": {
      "128": "icons/carometro-icon-192.png",
      "16": "icons/carometro-icon-192.png",
      "32": "icons/carometro-icon-192.png",
      "48": "icons/carometro-icon-192.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Assistente SIAP do Professor",
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.28.104",
   "web_accessible_resources": [ {
      "matches": [ "https://siap.educacao.go.gov.br/*" ],
      "resources": [ "src/carometro-icon.svg" ]
   } ]
}
